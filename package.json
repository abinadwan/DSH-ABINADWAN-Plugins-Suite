{
  "name": "@abinadwan/dsh-plugins-suite",
  "version": "0.7.0",
  "description": "DeepSeek Harness suite with Environment & Context, Humanizer and local Personal Profile settings.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./icon.svg": "./icon.svg",
    "./environment-context/icon": "./plugins/environment-context/icon.png",
    "./environment-context": "./plugins/environment-context/index.js",
    "./environment-context/locale/*.json": "./plugins/environment-context/locale/*.json",
    "./humanizer": "./plugins/humanizer/index.js",
    "./humanizer/locale/*.json": "./plugins/humanizer/locale/*.json",
    "./humanizer/icon": "./plugins/humanizer/icon.png",
    "./personal-profile": "./plugins/personal-profile/index.js",
    "./personal-profile/locale/*.json": "./plugins/personal-profile/locale/*.json",
    "./personal-profile/icon": "./plugins/personal-profile/icon.png",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "icon.svg",
    "locale/*.json",
    "docs",
    "plugins",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "check:package": "node scripts/check-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access"
      ]
    }
  },
  "icon": "./icon.png",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugins-suite",
    "abinadwan",
    "saudi-avatar",
    "environment-sidebar",
    "context-window",
    "token-usage",
    "ai-agents",
    "humanizer",
    "personal-profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite.git"
  },
  "homepage": "https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite#readme",
  "bugs": {
    "url": "https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.6 <2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
