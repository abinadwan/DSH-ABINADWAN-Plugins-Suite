{
  "name": "@abinadwan/environment-sidebar",
  "version": "0.2.1",
  "description": "A read-only right sidebar for DeepSeek Harness with workspace context, token usage, and session activity.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/DETAIL.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "environment",
    "context-window",
    "token-usage",
    "sidebar",
    "session-inspector",
    "agent-observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abinadwan/deepseek-harness-environment-sidebar.git"
  },
  "homepage": "https://github.com/abinadwan/deepseek-harness-environment-sidebar#readme",
  "bugs": {
    "url": "https://github.com/abinadwan/deepseek-harness-environment-sidebar/issues"
  }
}
