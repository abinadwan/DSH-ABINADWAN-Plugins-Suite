{
  "name": "@abinadwan/dsh-plugins-suite",
  "version": "1.0.2",
  "description": "Six-component DeepSeek Harness suite: Environment & Context, Humanizer, My Profile, Direct Chat, Chat Control and Adaptive Reasoning.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./icon.svg": "./icon.svg",
    "./environment-context/icon": "./plugins/environment-context/icon.png",
    "./environment-context": "./plugins/environment-context/index.js",
    "./environment-context/locale/*.json": "./plugins/environment-context/locale/*.json",
    "./humanizer": "./plugins/humanizer/index.js",
    "./humanizer/locale/*.json": "./plugins/humanizer/locale/*.json",
    "./humanizer/icon": "./plugins/humanizer/icon.png",
    "./personal-profile": "./plugins/personal-profile/index.js",
    "./personal-profile/locale/*.json": "./plugins/personal-profile/locale/*.json",
    "./personal-profile/icon": "./plugins/personal-profile/icon.png",
    "./direct-chat": "./plugins/direct-chat/index.js",
    "./direct-chat/locale/*.json": "./plugins/direct-chat/locale/*.json",
    "./direct-chat/icon": "./plugins/direct-chat/assets/png/icon-256.png",
    "./direct-chat/icon.svg": "./plugins/direct-chat/assets/icon.svg",
    "./conversation-lifecycle": "./plugins/conversation-lifecycle/index.js",
    "./conversation-lifecycle/locale/*.json": "./plugins/conversation-lifecycle/locale/*.json",
    "./conversation-lifecycle/icon": "./plugins/conversation-lifecycle/assets/png/icon-256.png",
    "./conversation-lifecycle/icon.svg": "./plugins/conversation-lifecycle/assets/icon.svg",
    "./adaptive-reasoning": "./plugins/adaptive-reasoning/index.js",
    "./adaptive-reasoning/locale/*.json": "./plugins/adaptive-reasoning/locale/*.json",
    "./adaptive-reasoning/icon": "./plugins/adaptive-reasoning/assets/png/icon-256.png",
    "./adaptive-reasoning/icon.svg": "./plugins/adaptive-reasoning/assets/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "icon.svg",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/BRANDING.md",
    "docs/PERSONAL_PROFILE_LOCAL_SETTINGS.md",
    "docs/PERSONAL_PROFILE_WINDOWS_ACCEPTANCE.md",
    "docs/PERSONAL_PROFILE_V072_CHANGE_RECORD.md",
    "docs/assets/environment-*.webp",
    "plugins",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "check:package": "node scripts/check-package.mjs",
    "check:regression": "node --test test/phase08-regression.test.js && node qa/adaptive-reasoning-benchmark.mjs --json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway/client",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "icon": "./icon.png",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugins-suite",
    "abinadwan",
    "environment-sidebar",
    "context-window",
    "token-usage",
    "ai-agents",
    "humanizer",
    "my-profile",
    "direct-chat",
    "chat-control",
    "adaptive-reasoning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite.git"
  },
  "homepage": "https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite#readme",
  "bugs": {
    "url": "https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.6 <2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
