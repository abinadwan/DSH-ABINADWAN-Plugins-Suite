{
  "name": "@abinadwan/dsh-plugins-suite",
  "version": "0.4.0",
  "description": "An open-source DeepSeek Harness plugin suite for context inspection, with future writing and personal-profile modules.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./icon.svg": "./icon.svg",
    "./environment-context/icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/DETAIL.md",
    "README.md",
    "LICENSE",
    "icon.png",
    "plugins/*/README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "icon": "./icon.png",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugins-suite",
    "abinadwan",
    "saudi-avatar",
    "environment-sidebar",
    "context-window",
    "token-usage",
    "ai-agents",
    "humanizer",
    "personal-profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite.git"
  },
  "homepage": "https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite#readme",
  "bugs": {
    "url": "https://github.com/abinadwan/DSH-ABINADWAN-Plugins-Suite/issues"
  },
  "license": "MIT"
}
